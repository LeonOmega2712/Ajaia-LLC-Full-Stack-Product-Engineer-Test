generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by migrations. Neon's Vercel integration sets this var.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  name      String
  createdAt DateTime        @default(now())
  documents Document[]
  shares    DocumentShare[]
  presence  DocumentPresence[]
}

model Document {
  id        String          @id @default(cuid())
  title     String
  /// Rich text stored as TipTap-generated HTML (schema-constrained by the editor).
  content   String          @default("")
  ownerId   String
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shares    DocumentShare[]
  presence  DocumentPresence[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([ownerId])
}

enum ShareRole {
  VIEWER
  EDITOR
}

model DocumentShare {
  id         String    @id @default(cuid())
  documentId String
  userId     String
  role       ShareRole @default(EDITOR)
  createdAt  DateTime  @default(now())
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}

/// Last heartbeat of a user viewing a document; "active" means seen within a short window.
model DocumentPresence {
  documentId String
  userId     String
  lastSeenAt DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([documentId, lastSeenAt])
}
