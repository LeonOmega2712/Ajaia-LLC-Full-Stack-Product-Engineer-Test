# Postgres connection strings. Locally both can point to the same database.
# On Neon: DATABASE_URL = pooled connection, DATABASE_URL_UNPOOLED = direct connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajaia"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ajaia"
# Secret used to sign the mock session cookie (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"
